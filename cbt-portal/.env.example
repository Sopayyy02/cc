# Salin ke .env lalu GANTI semua nilai bertanda GANTI_. File .env tidak boleh di-commit.
# Semua variabel di bawah wajib diisi: aplikasi tidak punya nilai bawaan (NFR-04).

# ===== Aplikasi =====
PORT=3000
APP_PORT=3000
# Bind only on localhost by default; set APP_BIND_IP=0.0.0.0 for your own trusted LAN.
APP_BIND_IP=127.0.0.1
SESSION_SECRET=GANTI_dengan_string_acak_min_32_karakter
INTERNAL_TOKEN=GANTI_dengan_token_acak_antar_service
EXAM_SERVICE_URL=http://localhost:3002   # hanya dipakai bila jalan tanpa Docker

# ===== Koneksi database (dibaca backend) =====
# Di Docker, DB_HOST otomatis diganti "mysql" oleh docker-compose.yml.
# Untuk jalan tanpa Docker (npm start), pakai localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cbt_portal
DB_USER=cbt_user
DB_PASSWORD=GANTI_password_db

# ===== Container MySQL (dibaca image mysql) =====
# MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD harus sama dengan DB_NAME, DB_USER, DB_PASSWORD.
MYSQL_ROOT_PASSWORD=GANTI_password_root
MYSQL_DATABASE=cbt_portal
MYSQL_USER=cbt_user
MYSQL_PASSWORD=GANTI_password_db

# ===== Stress test (opsional, Pertemuan 3) =====
# Tambah siswa dummy LT0001..LT<n> saat db-init berjalan. 0 = tidak menambah.
LOADTEST_STUDENTS=0

# Optional local Grafana stack (used only with docker-compose.observability.yml)
GRAFANA_ADMIN_PASSWORD=GANTI_password_grafana_min_20_karakter
